<Window x:Class="NewMainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PSX_XMB_Manager"
        mc:Ignorable="d"
        Title="PSX XMB Manager" Height="440" Width="875" Background="#FF252525" ResizeMode="CanMinimize" WindowStartupLocation="CenterScreen">
    <Grid x:Name="MainGrid">

        <Menu x:Name="MainMenu" Background="{x:Null}" HorizontalAlignment="Left" VerticalAlignment="Top" Width="250" Margin="0,20,0,0">
            <MenuItem x:Name="StartMenuItem" Background="#FF004671" Foreground="White" FontFamily="Calibri" FontSize="24" HorizontalAlignment="Left" Height="40" Header="Start" VerticalAlignment="Top" Width="250"/>
            <MenuItem x:Name="ProjectsMenuItem" Background="#FF00619C" Foreground="White" FontFamily="Calibri" FontSize="24" HorizontalAlignment="Left" Height="40" Header="Manage Projects" VerticalAlignment="Top" Width="250"/>
            <MenuItem x:Name="PartitionManagerMenuItem" Background="#FF00619C" Foreground="White" FontFamily="Calibri" FontSize="24" HorizontalAlignment="Left" Height="40" Header="HDD Partition Manager" VerticalAlignment="Top" Width="250"/>
            <MenuItem x:Name="PS1GameLibraryMenuItem" Background="#FF00619C" Foreground="White" FontFamily="Calibri" FontSize="24" HorizontalAlignment="Left" Height="40" Header="PS1 Games Library" VerticalAlignment="Top" Width="250"/>
            <MenuItem x:Name="PS2GameLibraryMenuItem" Background="#FF00619C" Foreground="White" FontFamily="Calibri" FontSize="24" HorizontalAlignment="Left" Height="40" Header="PS2 Games Library" VerticalAlignment="Top" Width="250"/>
            <MenuItem x:Name="UtilitiesMenuItem" Background="#FF00619C" Foreground="White" FontFamily="Calibri" FontSize="24" HorizontalAlignment="Left" Height="40" Header="Utilities" VerticalAlignment="Top" Width="250"/>
            <MenuItem x:Name="XMBToolsMenuItem" Background="#FF00619C" Foreground="White" FontFamily="Calibri" FontSize="24" HorizontalAlignment="Left" Height="40" Header="XMB Tools" VerticalAlignment="Top" Width="250"/>
            <MenuItem x:Name="WslSetupMenuItem" Background="#FF00619C" Foreground="White" FontFamily="Calibri" FontSize="24" HorizontalAlignment="Left" Height="40" Header="WSL2 Setup" VerticalAlignment="Top" Width="250"/>
            <MenuItem x:Name="DokanDriverMenuItem" Background="#FF00619C" Foreground="White" FontFamily="Calibri" FontSize="24" HorizontalAlignment="Left" Height="40" Header="Dokan (Local HDD only)" VerticalAlignment="Top" Width="250"/>
        </Menu>

        <Grid x:Name="StartGrid">
            <TextBlock HorizontalAlignment="Left" Margin="328,22,0,0" TextWrapping="Wrap" Text="Connection Method :" VerticalAlignment="Top" Foreground="White" FontFamily="Calibri" FontSize="16"/>
            <ComboBox x:Name="ConnectionMethodComboBox" HorizontalAlignment="Left" Margin="520,20,0,0" VerticalAlignment="Top" Width="271" Height="24" FontSize="14"/>
            <TextBlock x:Name="WslDistroLabel" HorizontalAlignment="Left" Margin="328,52,0,0" TextWrapping="Wrap" Text="WSL2 Distribution :" VerticalAlignment="Top" Foreground="White" FontFamily="Calibri" FontSize="16"/>
            <ComboBox x:Name="WslDistroComboBox" HorizontalAlignment="Left" Margin="520,50,0,0" VerticalAlignment="Top" Width="271" Height="24" FontSize="14"/>
            <TextBlock x:Name="EnterIPLabel" Margin="328,88,0,0" TextWrapping="Wrap" Text="Enter the IP address of your PSX :" VerticalAlignment="Top" Foreground="White" FontFamily="Calibri" FontSize="16" HorizontalAlignment="Left" Width="383"/>
            <TextBlock x:Name="PortLabel" Margin="716,88,0,0" TextWrapping="Wrap" Text="NBD Port :" VerticalAlignment="Top" Foreground="White" FontFamily="Calibri" FontSize="16" HorizontalAlignment="Left"/>
            <TextBox x:Name="PSXIPTextBox" Margin="328,112,0,0" TextWrapping="NoWrap" VerticalAlignment="Top" TextAlignment="Center" Width="383" HorizontalAlignment="Left" FontSize="14" Height="23"/>
            <TextBox x:Name="PSXPortTextBox" Margin="716,112,0,0" TextWrapping="NoWrap" VerticalAlignment="Top" TextAlignment="Center" Width="75" HorizontalAlignment="Left" FontSize="14" Height="23" Text="10809" ToolTip="Open PS2 Loader's NBD server uses port 10809."/>
            <Button x:Name="InstallRepairWslButton" Content="Install / Repair WSL Backend" HorizontalAlignment="Left" Margin="328,142,0,0" VerticalAlignment="Top" Background="#FF00619C" Foreground="White" BorderBrush="{x:Null}" Width="190" Height="24" FontFamily="Calibri" FontSize="14"/>
            <Button x:Name="RecoverWslButton" Content="Recover Connection" HorizontalAlignment="Left" Margin="523,142,0,0" VerticalAlignment="Top" Background="#FF00619C" Foreground="White" BorderBrush="{x:Null}" Width="137" Height="24" FontFamily="Calibri" FontSize="14" ToolTip="Recover WSL Connection: cleans up an old or broken NBD/PFS mount inside WSL."/>
            <Button x:Name="ConnectButton" Content="Connect" HorizontalAlignment="Left" Margin="665,142,0,0" VerticalAlignment="Top" Background="#FF00619C" Foreground="White" BorderBrush="{x:Null}" Width="126" Height="24" FontFamily="Calibri" FontSize="14"/>
            <TextBlock x:Name="WslStatusTitleLabel" HorizontalAlignment="Left" Margin="328,190,0,0" TextWrapping="NoWrap" Text="WSL2 Backend :" VerticalAlignment="Top" Foreground="White" FontFamily="Calibri" FontSize="16"/>
            <TextBlock x:Name="WslStatusLabel" HorizontalAlignment="Left" Margin="470,190,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Text="Checking..." VerticalAlignment="Top" Foreground="Orange" FontFamily="Calibri" FontSize="16" TextAlignment="Right" Width="321"/>
            <TextBlock x:Name="WslToolsTitleLabel" HorizontalAlignment="Left" Margin="328,215,0,0" TextWrapping="NoWrap" Text="Linux PS2 Tools :" VerticalAlignment="Top" Foreground="White" FontFamily="Calibri" FontSize="16"/>
            <TextBlock x:Name="WslToolsStatusLabel" HorizontalAlignment="Left" Margin="470,215,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Text="Checking..." VerticalAlignment="Top" Foreground="Orange" FontFamily="Calibri" FontSize="16" TextAlignment="Right" Width="321"/>
            <TextBlock HorizontalAlignment="Left" Margin="328,240,0,0" TextWrapping="NoWrap" Text="Dokan (Local HDD only) :" VerticalAlignment="Top" Foreground="White" FontFamily="Calibri" FontSize="16"/>
            <TextBlock x:Name="DokanDriverVersionLabel" HorizontalAlignment="Left" Margin="500,240,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Text="Not installed (optional)" VerticalAlignment="Top" Foreground="Gray" FontFamily="Calibri" FontSize="16" TextAlignment="Right" Width="291"/>
            <TextBlock x:Name="NBDConnectionStatusLabel" HorizontalAlignment="Left" Margin="328,265,0,0" TextWrapping="NoWrap" Text="Connection Status :" VerticalAlignment="Top" Foreground="White" FontFamily="Calibri" FontSize="16"/>
            <TextBlock x:Name="NBDConnectionLabel" HorizontalAlignment="Left" Margin="470,265,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Text="Not connected" VerticalAlignment="Top" Foreground="#FFC12249" FontFamily="Calibri" FontSize="16" Width="321" TextAlignment="Right"/>
            <TextBlock HorizontalAlignment="Left" Margin="328,290,0,0" TextWrapping="NoWrap" Text="PSX HDD Status :" VerticalAlignment="Top" Foreground="White" FontFamily="Calibri" FontSize="16"/>
            <TextBlock x:Name="MountStatusLabel" HorizontalAlignment="Left" Margin="470,290,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Text="Unmounted" VerticalAlignment="Top" Foreground="#FFC12249" FontFamily="Calibri" FontSize="16" Width="321" TextAlignment="Right"/>
            <TextBlock x:Name="BackendActivityLabel" HorizontalAlignment="Left" Margin="328,325,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Text="" VerticalAlignment="Top" Foreground="#FFB0B0B0" FontFamily="Calibri" FontSize="13" Width="463"/>
        </Grid>

        <Grid x:Name="ProjectsGrid" Visibility="Hidden" Opacity="0">
            <Button x:Name="NewHomebrewProjectButton" Content="New Homebrew Project" HorizontalAlignment="Left" Margin="279,46,0,0" VerticalAlignment="Top" Background="#FF00619C" Foreground="White" BorderBrush="{x:Null}" Width="180" Height="30" FontFamily="Calibri" FontSize="16"/>
            <Button x:Name="NewGameProjectButton" Content="New PS2 Game Project" HorizontalAlignment="Left" Margin="465,46,0,0" VerticalAlignment="Top" Background="#FF00619C" Foreground="White" BorderBrush="{x:Null}" Width="180" Height="30" FontFamily="Calibri" FontSize="16"/>
            <ComboBox x:Name="ProjectListComboBox" HorizontalAlignment="Left" Margin="279,143,0,0" VerticalAlignment="Top" Width="550"/>
            <TextBlock HorizontalAlignment="Left" Margin="279,118,0,0" TextWrapping="Wrap" Text="Manage or prepare a saved project :" VerticalAlignment="Top" Foreground="White" FontFamily="Calibri" FontSize="16"/>
            <Button x:Name="EditProjectButton" Content="Edit Project" HorizontalAlignment="Left" Margin="408,190,0,0" VerticalAlignment="Top" Background="#FF00619C" Foreground="White" BorderBrush="{x:Null}" Width="124" Height="24" FontFamily="Calibri" FontSize="14"/>
            <Button x:Name="PrepareProjectButton" Content="Prepare Project" HorizontalAlignment="Left" Margin="705,190,0,0" VerticalAlignment="Top" Background="#FF00619C" Foreground="White" BorderBrush="{x:Null}" Width="124" Height="24" FontFamily="Calibri" FontSize="14"/>
            <ComboBox x:Name="PreparedProjectsComboBox" HorizontalAlignment="Left" Margin="279,284,0,0" VerticalAlignment="Top" Width="550"/>
            <TextBlock HorizontalAlignment="Left" Margin="279,259,0,0" TextWrapping="Wrap" Text="Install a prepared project on the PSX :" VerticalAlignment="Top" Foreground="White" FontFamily="Calibri" FontSize="16"/>
            <TextBlock HorizontalAlignment="Left" Margin="649,170,0,0" TextWrapping="Wrap" Text="Select a created project from the list." VerticalAlignment="Top" Foreground="White" FontFamily="Calibri" TextAlignment="Right"/>
            <TextBlock HorizontalAlignment="Left" Margin="279,311,0,0" TextWrapping="Wrap" Text="Select a prepared project from the list to install on the PSX." VerticalAlignment="Top" Foreground="White" FontFamily="Calibri" TextAlignment="Right" Width="550"/>
            <Button x:Name="InstallProjectButton" Content="Install" HorizontalAlignment="Left" Margin="705,331,0,0" VerticalAlignment="Top" Background="#FF00619C" Foreground="White" BorderBrush="{x:Null}" Width="124" Height="24" FontFamily="Calibri" FontSize="14"/>
            <Button x:Name="NewPS1GameProjectButton" Content="New PS1 Game Project" HorizontalAlignment="Left" Margin="649,46,0,0" VerticalAlignment="Top" Background="#FF00619C" Foreground="White" BorderBrush="{x:Null}" Width="180" Height="30" FontFamily="Calibri" FontSize="16"/>
            <Button x:Name="DeleteProjectButton" Content="Delete Project" HorizontalAlignment="Left" Margin="279,190,0,0" VerticalAlignment="Top" Background="#FF00619C" Foreground="White" BorderBrush="{x:Null}" Width="124" Height="24" FontFamily="Calibri" FontSize="14"/>
        </Grid>

    </Grid>
</Window>
